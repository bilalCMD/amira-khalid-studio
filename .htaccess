RewriteEngine On

# The old journal articles were replaced by three first-person pieces.
# These 301s keep any indexed or shared links working.
RewriteRule ^journal-choosing-artist/?$      /journal-how-i-work      [R=301,L]
RewriteRule ^journal-right-fit/?$            /journal-how-i-work      [R=301,L]
RewriteRule ^journal-review-portfolio/?$     /journal-how-i-work      [R=301,L]
RewriteRule ^journal-philosophy/?$           /journal-how-i-work      [R=301,L]
RewriteRule ^journal-skin-prep/?$            /journal-skin-not-filter [R=301,L]
RewriteRule ^journal-makeup-last-longer/?$   /journal-skin-not-filter [R=301,L]
RewriteRule ^journal-jeddah-climate-makeup/?$ /journal-skin-not-filter [R=301,L]
RewriteRule ^journal-bridal-tips/?$          /journal-photo-match     [R=301,L]
RewriteRule ^journal-bridal-mistakes/?$      /journal-photo-match     [R=301,L]
RewriteRule ^journal-engagement-makeup/?$    /journal-photo-match     [R=301,L]
RewriteRule ^journal-eid-makeup/?$           /journal                 [R=301,L]
RewriteRule ^journal-bridal-pricing-guide/?$ /pricing                 [R=301,L]

# If someone requests /page.html directly, redirect to the clean /page URL
# (except Google's site-verification file, which must be served at its exact URL)
RewriteCond %{THE_REQUEST} \s/+(.+)\.html[\s?] [NC]
RewriteCond %{THE_REQUEST} !google[a-f0-9]+\.html [NC]
RewriteRule ^ /%1 [R=301,L]

# Serve page.html when /page is requested (clean URLs)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^([^.]+)$ $1.html [L]

# Cache control: HTML pages must always be re-checked (so edits show up
# immediately), CSS/JS/images can be cached longer since their URLs
# include a ?v= version number that changes whenever they're updated.
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(css|js|jpg|jpeg|png|webp|svg|mp4|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
